---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTranslations, navigationItems } from "@i18n/ui";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-main">
    <div class="identity">
      <a class="brand" href={getRelativeLocaleUrl(locale, "/")}>
        {t.brand}
      </a>
      <p>{t.footerDescription}</p>
    </div>
    <nav aria-label={t.footerNavigation}>
      <ul>
        {navigationItems.map(({ path, label }) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, path)}>{t[label]}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>
      &copy; {year} {t.brand}
    </span>
    <span>{t.country}</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 1rem;
  }
  .footer-main,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .footer-main {
    align-items: flex-start;
    padding-bottom: 2rem;

    @media (max-width: 36rem) {
      flex-direction: column;
    }
  }
  .brand {
    color: var(--color-link);
    font-weight: 600;
    text-decoration: none;
    &:hover,
    &:focus-visible {
      color: var(--color-accent-link);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
  .identity p {
    color: var(--color-muted);
    margin: 0.5rem 0 0;
  }
  nav {
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    a {
      text-decoration: none;
      &:hover,
      &:focus-visible {
        color: var(--color-accent-link);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
    padding-top: 1rem;
  }
</style>
