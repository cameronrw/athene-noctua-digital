---
import { getTranslations } from "@i18n/ui";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<label class="theme-control">
  <span
    data-theme-label
    data-dark-label={t.darkMode}
    data-light-label={t.lightMode}
  >
    {t.darkMode}
  </span>
  <input type="checkbox" role="switch" data-theme-toggle />
</label>

<script>
  const toggle = document.querySelector<HTMLInputElement>(
    "[data-theme-toggle]",
  );
  const label = document.querySelector<HTMLElement>("[data-theme-label]");
  if (toggle) {
    const preference = window.matchMedia("(prefers-color-scheme: dark)");
    const syncToggle = () => {
      toggle.checked =
        document.documentElement.dataset.theme === "dark" ||
        (!document.documentElement.dataset.theme && preference.matches);
      if (label) {
        label.textContent = toggle.checked
          ? (label.dataset.darkLabel ?? "")
          : (label.dataset.lightLabel ?? "");
      }
    };

    syncToggle();
    preference.addEventListener("change", syncToggle);
    toggle.addEventListener("change", () => {
      const theme = toggle.checked ? "dark" : "light";
      document.documentElement.dataset.theme = theme;
      syncToggle();
      try {
        localStorage.setItem("theme", theme);
      } catch {
        return;
      }
    });
  }
</script>

<style>
  .theme-control {
    align-items: center;
    cursor: pointer;
    display: inline-flex;
    gap: 0.5rem;
    white-space: nowrap;

    input {
      appearance: none;
      background: var(--color-on-accent);
      border: 2px solid var(--color-on-accent);
      border-radius: 1rem;
      cursor: pointer;
      height: 1.5rem;
      margin: 0;
      position: relative;
      width: 2.75rem;

      &::before {
        background: var(--color-lemon-lime);
        border-radius: 50%;
        content: "";
        height: 1rem;
        left: 0.125rem;
        position: absolute;
        top: 0.125rem;
        transition: transform 150ms ease;
        width: 1rem;
      }

      &:checked::before {
        transform: translateX(1.2rem);
      }

      &:focus-visible {
        outline: 2px solid var(--color-on-accent);
        outline-offset: 3px;
      }
    }
  }
</style>
