---
import { getTranslations } from "@i18n/ui";
import logoSvg from "../../public/athene-noctua-digital-logo.svg?raw";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<a class="brand" href="/">
  <span class="brand-logo" aria-hidden="true" set:html={logoSvg} />
  <span>{t.brand}</span>
</a>

<style>
  .brand {
    align-items: center;
    display: flex;
    font-size: 1rem;
    font-weight: normal;
    gap: 1rem;
    margin: 0;
    text-transform: uppercase;

    &:hover,
    &:focus {
      text-decoration: none;
    }
  }

  .brand-logo {
    --logo-accent: var(--color-lemon-lime);

    color: var(--color-gunmetal);
    display: block;
    height: 2rem;
    width: 1.5rem;
  }
</style>
