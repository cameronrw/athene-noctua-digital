---
import { getRelativeLocaleUrl } from "astro:i18n";
import Button from "@components/Button.astro";
import { getTranslations } from "@i18n/ui";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="home-hero">
  <h1>
    <span class="headline">{t.homeHeroHeadline}</span>
    <span class="headline-emphasis">{t.homeHeroHeadlineEmphasis}</span>
  </h1>
  <p class="home-hero-description">{t.homeHeroDescription}</p>
  <Button variant="primary" href={getRelativeLocaleUrl(locale, "/about")}>
    {t.about}
  </Button>
</section>

<style>
  .home-hero {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    > * {
      margin: 0;
    }
  }

  .headline {
    display: block;
    font-family: var(--font-inter), system-ui, sans-serif;
    font-size: 6rem;
    font-weight: normal;
    text-transform: uppercase;
  }

  .headline-emphasis {
    color: var(--color-lemon-lime);
    display: block;
    font-family: var(--font-lora), Georgia, serif;
    font-size: 6.5rem;
    font-style: italic;
    font-weight: normal;
  }

  .home-hero-description {
    font-size: 1.25rem;
  }
</style>
